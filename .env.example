# Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon or publishable key (Settings > API; safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_ORDER_EMAIL=

# Enable only after the existing target schema, seed, roles and policies are verified.
SURPRISEWALA_CMS_ENABLED=false

# Server-only payment preparation. Leave disabled until schema, policies and dashboard are verified.
PAYHERE_ENABLED=false
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_SITE_URL=https://surprisewala.com
SUPABASE_SERVICE_ROLE_KEY=
# Canonical production URL
NEXT_PUBLIC_SITE_URL=

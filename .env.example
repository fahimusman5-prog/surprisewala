# Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon or publishable key (Settings > API; safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Leave unset unless an admin-only server operation genuinely needs it.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical production URL, for example https://surprisewala.com
NEXT_PUBLIC_SITE_URL=
